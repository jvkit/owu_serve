# PRIME AI 环境变量模板
# 复制为 .env 后填写实际值；敏感项部署时从旧配置迁移，勿提交真实值。

# ===== 通用 =====
TZ=Asia/Shanghai

# ===== Open WebUI（prime-open-webui）=====
# WEBUI_SECRET_KEY 必须与旧 open-webui 容器保持一致（否则已有会话/token 失效）
WEBUI_SECRET_KEY=CHANGE_ME
# 若 OWU 需要直连 ollama（embedding 在本地模型缓存中，通常不需要）
OLLAMA_BASE_URL=http://ollama:11434
OPENAI_API_KEY=CHANGE_ME

# ===== Gateway（prime-gateway，模型网关 + 用户中心 + 知识库）=====
# OWU 后端地址（compose 内服务名，勿改）
OPENWEBUI_BASE_URL=http://open-webui:8080
# gateway 用 OWU 管理员账号操作 OWU（创建知识库/同步模型等）
OPENWEBUI_EMAIL=CHANGE_ME
OPENWEBUI_PASSWORD=CHANGE_ME
# NewAPI（模型上游）连接信息 —— 从旧 /home/liyang/owu-gateway/.env 迁移
NEW_API_BASEURL=CHANGE_ME
NEWAPI_ADMIN_ACCESS_TOKEN=CHANGE_ME
# 可用模型白名单（逗号分隔）
ALLOWED_MODELS=deepseek-v4-flash,deepseek-v4-pro,glm-5.2
# 会话密钥（随机生成一次即可，重启不变）
SESSION_SECRET=CHANGE_ME

# ===== Feedback（prime-feedback，反馈服务）=====
# 反馈服务对接的 OWU 地址（compose 内服务名，勿改）
OWUI_BASE_URL=http://open-webui:8080
